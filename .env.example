APP_NAME=Easemovie Backend
HOST=0.0.0.0
PORT=8000
MEDIA_ROOT=media

# ========== Firebase ==========
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIRESTORE_PROJECTS_COLLECTION=projects
FIRESTORE_USERS_COLLECTION=users
# SKIP_FIRESTORE_STARTUP=true

# ========== Auth (JWT) ==========
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========== Replicate API keys ==========
# https://replicate.com/account/api-tokens
IMAGE_REPLICATE_API_TOKEN=r8_your_flux_token_here
VIDEO_REPLICATE_API_TOKEN=r8_your_svd_token_here
# REPLICATE_API_TOKEN=

# ========== Models ==========
IMAGE_MODEL=black-forest-labs/flux-dev
VIDEO_MODEL=sunfjun/stable-video-diffusion

# ========== SVD tuning (25 frames @ 5 fps ≈ 5 sec/scene → 4 scenes ≈ 20 sec film) ==========
SVD_VIDEO_LENGTH=25_frames_with_svd_xt
SVD_FRAMES_PER_SECOND=5
SVD_MOTION_BUCKET_ID=180
SVD_COND_AUG=0.02
SVD_DECODING_T=8

PUBLIC_BASE_URL=http://192.168.1.20:8000

FLUX_ASPECT_RATIO=16:9
FLUX_OUTPUT_FORMAT=png
FLUX_NUM_INFERENCE_STEPS=28
FLUX_GUIDANCE=3.5

REPLICATE_POLL_INTERVAL_SECONDS=2.0
REPLICATE_POLL_TIMEOUT_SECONDS=900.0
ALLOW_AI_FALLBACK=false

# Long video routes return job_id immediately; client polls GET /jobs/{job_id}
GENERATION_ASYNC_DEFAULT=true

# ========== ElevenLabs (story narration — auto mood voice) ==========
# Key yahan paste karo: https://elevenlabs.io/app/settings/api-keys
# Key na ho to Edge TTS fallback use hoga (voice: auto still works).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true

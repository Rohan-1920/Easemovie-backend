APP_NAME=Easemovie Backend
HOST=0.0.0.0
PORT=8000
MEDIA_ROOT=media

# ========== Firebase (projects API) ==========
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIRESTORE_PROJECTS_COLLECTION=projects

# ========== Replicate API keys (2 models) ==========
# Get tokens: https://replicate.com/account/api-tokens
IMAGE_REPLICATE_API_TOKEN=r8_your_flux_token_here
VIDEO_REPLICATE_API_TOKEN=r8_your_svd_token_here

# Optional: one token for both models (same Replicate account)
# REPLICATE_API_TOKEN=

# ========== Models ==========
IMAGE_MODEL=black-forest-labs/flux-dev
VIDEO_MODEL=sunfjun/stable-video-diffusion

# ========== SVD budget tuning (sunfjun ~$0.04 per clip on Replicate) ==========
# 14_frames = cheaper | 25_frames_with_svd_xt = longer but costs more
SVD_VIDEO_LENGTH=14_frames_with_svd
SVD_FRAMES_PER_SECOND=6
SVD_MOTION_BUCKET_ID=180
SVD_COND_AUG=0.02
SVD_DECODING_T=8

# Optional expensive model: kwaivgi/kling-v2.5-turbo-pro
# KLING_DURATION=5
# KLING_ASPECT_RATIO=16:9

# ========== IMPORTANT for video generation ==========
# Your PC's LAN URL so Replicate can download scene images.
# Find IP: ipconfig (Windows) → use IPv4, e.g. http://192.168.1.20:8000
# Same URL helps Android app load /media files.
PUBLIC_BASE_URL=http://192.168.1.20:8000

# ========== FLUX (image) tuning ==========
FLUX_ASPECT_RATIO=16:9
FLUX_OUTPUT_FORMAT=png
FLUX_NUM_INFERENCE_STEPS=28
FLUX_GUIDANCE=3.5

# ========== Stable Video Diffusion tuning ==========
SVD_VIDEO_LENGTH=14_frames_with_svd
SVD_FRAMES_PER_SECOND=6
SVD_MOTION_BUCKET_ID=127
SVD_COND_AUG=0.02
SVD_DECODING_T=14

# ========== Replicate polling ==========
REPLICATE_POLL_INTERVAL_SECONDS=2.0
REPLICATE_POLL_TIMEOUT_SECONDS=900.0

# If true: API errors → fallback PNG / static slideshow (NOT real animation)
ALLOW_AI_FALLBACK=false

# pytest only
# SKIP_FIRESTORE_STARTUP=true

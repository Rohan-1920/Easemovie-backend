APP_NAME=Easemovie Backend
HOST=0.0.0.0
PORT=8000
MEDIA_ROOT=media

# Firebase Admin SDK JSON (download from Firebase Console → Project settings → Service accounts)
# Put the file in this folder e.g. firebase-service-account.json and DO NOT commit it.
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Firestore collection name (same collection Easemovie Android app uses → keeps data in one place)
FIRESTORE_PROJECTS_COLLECTION=projects

STABILITY_API_KEY=your_stability_api_key_here
STABILITY_BASE_URL=https://api.stability.ai/v2beta/stable-image/generate/core

APP_NAME=Easemovie Backend
HOST=0.0.0.0
PORT=8000
MEDIA_ROOT=media

# ========== Firebase ==========
# Local: JSON file in project root (gitignored — do not commit)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
# Render.com: paste full service-account JSON as one env var (recommended), OR use Secret File:
#   FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIRESTORE_PROJECTS_COLLECTION=projects
FIRESTORE_USERS_COLLECTION=users

# ========== Auth (JWT) ==========
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========== Replicate API keys ==========
# https://replicate.com/account/api-tokens
IMAGE_REPLICATE_API_TOKEN=r8_your_flux_token_here
VIDEO_REPLICATE_API_TOKEN=r8_your_svd_token_here
# REPLICATE_API_TOKEN=

# ========== Models (budget setup) ==========
IMAGE_MODEL=black-forest-labs/flux-dev
VIDEO_MODEL=sunfjun/stable-video-diffusion

# ========== SVD tuning (~$0.04/clip) ==========
SVD_VIDEO_LENGTH=14_frames_with_svd
SVD_FRAMES_PER_SECOND=6
SVD_MOTION_BUCKET_ID=180
SVD_COND_AUG=0.02
SVD_DECODING_T=8

PUBLIC_BASE_URL=http://192.168.100.12:8000

FLUX_ASPECT_RATIO=16:9
FLUX_OUTPUT_FORMAT=png
FLUX_NUM_INFERENCE_STEPS=28
FLUX_GUIDANCE=3.5

REPLICATE_POLL_INTERVAL_SECONDS=2.0
REPLICATE_POLL_TIMEOUT_SECONDS=900.0
ALLOW_AI_FALLBACK=false

# pytest / local without Firebase JSON
# SKIP_FIRESTORE_STARTUP=true
